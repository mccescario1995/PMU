<IfModule mod_rewrite.c>

    RewriteEngine On

    # --- Existing files/dirs ---
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- API: route /api/... to /api/index.php ---
    RewriteRule ^api(?:/(.*))?$ api/index.php [L,QSA]

    # --- Nuxt SPA fallback ---
    RewriteRule ^ index.html [L]
</IfModule>
